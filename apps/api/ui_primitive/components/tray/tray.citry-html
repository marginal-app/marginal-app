<div c-class="host_class">
  <c-if cond="show_dismiss">
    <a
      class="ds-tray-dismiss"
      c-href="dismiss_url"
      c-bind="dismiss_attrs"
      aria-label="닫기"
    ></a>
  </c-if>
  <aside c-class="class_name" c-aria-hidden="aria_hidden">
    <c-slot>
      <c-if cond="body"><div class="ds-tray-body">{{ body }}</div></c-if>
    </c-slot>
  </aside>
</div>
