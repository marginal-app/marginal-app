<div class="identity-settings">
  <c-sidebar c-state="'expanded'" c-active="'settings'" />
  <div class="identity-settings__body">
    <h1 class="identity-settings__title">설정</h1>
    <div class="identity-settings__stack">
      <section class="identity-section">
        <div class="identity-section__head">
          <h2 class="identity-section__title">계정</h2>
        </div>
        <div class="identity-account">
          <c-avatar c-initials="initials" />
          <div class="identity-account__who">
            <p class="identity-account__name">{{ username }}</p>
            <p class="identity-account__meta">{{ account_meta }}</p>
          </div>
          <c-if cond="show_logout_form">
            <form method="post" c-action="logout_url">
              <input type="hidden" name="csrfmiddlewaretoken" c-value="csrf_token">
              <c-button c-label="'로그아웃'" c-kind="'quiet'" c-html_type="'submit'" />
            </form>
          </c-if>
          <c-else>
            <c-button c-label="'로그아웃'" c-kind="'quiet'" />
          </c-else>
        </div>
      </section>

      <section class="identity-section">
        <div class="identity-section__head">
          <h2 class="identity-section__title">API 토큰</h2>
          <p class="identity-section__kicker">{{ token_kicker }}</p>
        </div>
        <p class="identity-note">{{ token_blurb }}</p>
        <c-if cond="has_issued">
          <div class="identity-token-once">
            <code class="identity-token-once__value">{{ issued_token }}</code>
            <c-pill_button c-label="'복사'" c-icon="'copy'" />
          </div>
          <p class="identity-note">{{ issued_warning }}</p>
        </c-if>
        <c-elif cond="has_hint_only">
          <div class="identity-token-has">
            <code class="identity-token-has__value">{{ masked_token }}</code>
            <span class="identity-token-has__stamp">발급됨</span>
          </div>
        </c-elif>
        <c-else>
          <p class="identity-empty">{{ empty_copy }}</p>
        </c-else>
        <form class="identity-issue" method="post" c-action="action_url">
          <input type="hidden" name="csrfmiddlewaretoken" c-value="csrf_token">
          <c-button c-label="submit_label" c-html_type="'submit'" />
        </form>
      </section>

      <section class="identity-section">
        <div class="identity-section__head">
          <h2 class="identity-section__title">확장 연결</h2>
        </div>
        <div class="identity-server">
          <span class="identity-server__label">SERVER URL</span>
          <span class="identity-server__url">{{ server_url }}</span>
        </div>
        <p class="identity-note">{{ connect_hint }}</p>
      </section>
    </div>
  </div>
</div>
