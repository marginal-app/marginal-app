<li c-class="class_name">
  <a
    class="catalog-row-hit"
    c-href="href"
    c-bind="htmx_attrs"
  >
    <c-if cond="folio"><p class="catalog-row-folio">{{ folio }}</p></c-if>
    <div class="catalog-row-body">
      <p class="catalog-row-title">{{ heading }}</p>
      <p class="catalog-row-location">{{ location }}</p>
      <p class="catalog-row-meta">
        <c-if cond="bookmarked">북마크</c-if>
        <c-else>
          <c-if cond="highlight_count">밑줄 {{ highlight_count }}</c-if>
        </c-else>
      </p>
    </div>
  </a>
</li>
